# גרסה פשוטה יותר של Dockerfile
FROM node:18-alpine

WORKDIR /app

# Copy all files
COPY package*.json ./
COPY . .

# Install all dependencies
RUN npm install

# Build React app
RUN npm run build

# Install serve globally
RUN npm install -g serve

# Expose port
EXPOSE 3000

# Set environment
ENV NODE_ENV=production
ENV PORT=3000

# Start both services
CMD sh -c "cd server && node server.js & serve -s build -l 3000"

